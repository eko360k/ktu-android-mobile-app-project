<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="button_standard_margin">5dp</dimen>

    <!-- This makes a rounded square. Change 15dp to more or less as you like -->
    <style name="RoundedCorners">
        <item name="cornerSize">15dp</item>
    </style>

    <!-- This makes a perfect circle (WhatsApp style) -->
    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

    <style name="Circle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>

