<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout representation for a single card in the GridView.
  Uses MaterialCardView to support rounded corners, elevation, and card themes.
  Each card consists of an image, an optional badge/tag, and a text overlay with a readability scrim.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    android:layout_margin="6dp">

    <!-- Main card image - height increased from 160dp to 220dp to improve visual presence -->
    <ImageView
        android:id="@+id/image_view"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:src="@drawable/ic_launcher_background"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name"/>

    <!--
      Bottom scrim overlay to provide a semi-transparent dark background.
      This ensures text legibility on top of light-colored card images.
    -->
    <View
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_gravity="bottom"
        android:background="#99000000"/>

    <!--
      Optional badge/tag situated at the top-left of the card.
      Uses primary color background for high contrast.
    -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_margin="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorPrimary"
        app:cardCornerRadius="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"/>

    </com.google.android.material.card.MaterialCardView>

    <!--
      Card title text, aligned to the bottom.
      Includes a dark text shadow for enhanced readability over the scrim and image.
    -->
    <TextView
        android:id="@+id/text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/white"
        android:shadowColor="#B0000000"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="@string/app_name"
        android:textSize="16sp"
        android:textStyle="bold"/>

</com.google.android.material.card.MaterialCardView>