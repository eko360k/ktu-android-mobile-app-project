<?xml version="1.0" encoding="utf-8"?>

<!--
  Main Activity layout containing a title toolbar, scrollable content area with GridView,
  a call-to-action gradient button, and a BottomNavigationView for application routing.
-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Top Custom App Bar / Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Title of the screen/library -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_lib"
            android:textSize="35sp"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceTitleLarge"/>

        <!-- Search Icon Button -->
        <ImageButton
            android:id="@+id/search_button"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/baseline_search_24"
            android:contentDescription="@string/search"
            app:tint="?attr/colorOnSurface"/>

        <!-- Filter Icon Button -->
        <ImageButton
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/baseline_filter_list_24"
            android:contentDescription="@string/filter"
            app:tint="?attr/colorOnSurface"/>

        <!-- More Options Icon Button -->
        <ImageButton
            android:id="@+id/three_dot"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/baseline_more_vert_24"
            android:contentDescription="@string/more_options"
            app:tint="?attr/colorOnSurface"/>

    </LinearLayout>

    <!-- Scrollable main content section -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <!-- Inner container to hold grid and the action button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="38dp">

            <!--
              ExpandableGridView container with height set to wrap_content
              to automatically fit all items inside the parent ScrollView.
            -->
            <com.example.myfirstapp.ExpandableGridView
                android:id="@+id/grid_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:numColumns="2"
                android:verticalSpacing="10dp"
                android:horizontalSpacing="10dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="16dp"/>

            <!--
              Action button utilizing the premium gradient background.
              Requires app:backgroundTint="@null" to prevent Material3 theme override.
            -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_explore_more"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="@string/explore_more"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/gradient_button"
                app:backgroundTint="@null"/>

        </LinearLayout>

    </ScrollView>

    <!--
      Main Content Area Placeholder for Fragment navigation transactions.
      Commented out to prevent conflict/splitting layout height with the ScrollView.
    -->
    <!--
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    -->

    <!-- Bottom Navigation Bar for main app flows -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:backgroundTint="?attr/colorSurfaceContainer"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/buttom_menu" />

</LinearLayout>