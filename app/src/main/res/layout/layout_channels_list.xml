<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Channel Item 1: Tech Weekly -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/chan_img1"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:background="#F0F0F0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/Circle"
            app:srcCompat="@android:drawable/ic_menu_camera" />

        <TextView
            android:id="@+id/chan_name1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="Tech Weekly"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="17sp"
            app:layout_constraintEnd_toStartOf="@+id/chan_time1"
            app:layout_constraintStart_toEndOf="@id/chan_img1"
            app:layout_constraintTop_toTopOf="@id/chan_img1" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="The latest iPhone leaks are here..."
            android:textColor="?android:attr/textColorSecondary"
            app:layout_constraintEnd_toEndOf="@id/chan_name1"
            app:layout_constraintStart_toStartOf="@id/chan_name1"
            app:layout_constraintTop_toBottomOf="@id/chan_name1" />

        <TextView
            android:id="@+id/chan_time1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:40 PM"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/chan_name1" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="83dp"
        android:background="#33AAAAAA" />

    <!-- Channel Item 2: Global Cooking -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/chan_img2"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:background="#F0F0F0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/Circle"
            app:srcCompat="@android:drawable/ic_menu_gallery" />

        <TextView
            android:id="@+id/chan_name2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="Global Cooking"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="17sp"
            app:layout_constraintEnd_toStartOf="@+id/chan_time2"
            app:layout_constraintStart_toEndOf="@id/chan_img2"
            app:layout_constraintTop_toTopOf="@id/chan_img2" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="New recipe: Homemade pasta from scratch"
            android:textColor="?android:attr/textColorSecondary"
            app:layout_constraintEnd_toEndOf="@id/chan_name2"
            app:layout_constraintStart_toStartOf="@id/chan_name2"
            app:layout_constraintTop_toBottomOf="@id/chan_name2" />

        <TextView
            android:id="@+id/chan_time2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yesterday"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/chan_name2" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="83dp"
        android:background="#33AAAAAA" />

    <!-- Channel Item 3: Sports Central -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/chan_img3"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:background="#F0F0F0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/Circle"
            app:srcCompat="@android:drawable/ic_menu_compass" />

        <TextView
            android:id="@+id/chan_name3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="Sports Central"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="17sp"
            app:layout_constraintEnd_toStartOf="@+id/chan_time3"
            app:layout_constraintStart_toEndOf="@id/chan_img3"
            app:layout_constraintTop_toTopOf="@id/chan_img3" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Transfer window updates: Final hour deals!"
            android:textColor="?android:attr/textColorSecondary"
            app:layout_constraintEnd_toEndOf="@id/chan_name3"
            app:layout_constraintStart_toStartOf="@id/chan_name3"
            app:layout_constraintTop_toBottomOf="@id/chan_name3" />

        <TextView
            android:id="@+id/chan_time3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monday"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/chan_name3" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>