<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/update"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UpdateFragment">

    <!-- HEADER AREA (ConstraintLayout for the top row) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/updates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="13dp"
            android:fontFamily="sans-serif"
            android:text="@string/updates_page"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="23sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@null"
            android:clickable="true"
            app:tint="?android:attr/textColorPrimary"
            android:contentDescription="@string/search_btn"
            android:focusable="true"
            app:layout_constraintEnd_toStartOf="@id/options_button"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/search"
            tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck" />

        <ImageButton
            android:id="@+id/options_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@null"
            android:clickable="true"
            app:tint="?android:attr/textColorPrimary"
            android:contentDescription="@string/options_btn"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/baseline_more_vert_24"
            tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 1. NESTEDSCROLLVIEW: This makes the WHOLE page scrollable -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <!-- Everything you want to scroll MUST be inside this one LinearLayout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <TextView
                android:id="@+id/status_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-light"
                android:textStyle="bold"
                android:text="@string/status_scroller"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="21sp" />

            <FrameLayout
                android:id="@+id/frameLayout2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp">

                <!-- for status scroll -->
                <HorizontalScrollView
                    android:id="@+id/status_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="none"
                    tools:ignore="SpeakableTextPresentCheck">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/siv_image1"
                            android:layout_width="90dp"
                            android:layout_height="150dp"
                            android:layout_margin="3dp"
                            app:cardBackgroundColor="?attr/colorSurfaceVariant"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="?attr/colorOutlineVariant"
                            app:strokeWidth="1dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <!-- The Plus Icon -->
                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="center"
                                    android:layout_margin="8dp"
                                    app:srcCompat="@drawable/add"
                                    app:tint="?attr/colorPrimary" />

                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/siv_image2"
                            android:layout_width="90dp"
                            android:layout_height="150dp"
                            android:layout_margin="3dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/RoundedCorners"
                            app:srcCompat="@drawable/him" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/siv_image3"
                            android:layout_width="90dp"
                            android:layout_height="150dp"
                            android:layout_margin="3dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/RoundedCorners"
                            app:srcCompat="@drawable/supes"
                            tools:ignore="ImageContrastCheck" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/siv_image4"
                            android:layout_width="90dp"
                            android:layout_height="150dp"
                            android:layout_margin="3dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/RoundedCorners"
                            app:srcCompat="@drawable/becca" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/siv_image5"
                            android:layout_width="90dp"
                            android:layout_height="150dp"
                            android:layout_margin="3dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/RoundedCorners"
                            app:srcCompat="@drawable/luffy" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/siv_image6"
                            android:layout_width="90dp"
                            android:layout_height="150dp"
                            android:layout_margin="3dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/RoundedCorners"
                            app:srcCompat="@drawable/becca_guns" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/siv_image7"
                            android:layout_width="90dp"
                            android:layout_height="150dp"
                            android:layout_margin="3dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/RoundedCorners"
                            app:srcCompat="@drawable/peak" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/siv_image8"
                            android:layout_width="90dp"
                            android:layout_height="150dp"
                            android:layout_margin="3dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/RoundedCorners"
                            app:srcCompat="@drawable/shaula" />
                    </LinearLayout>
                </HorizontalScrollView>
            </FrameLayout>

            <!-- Channels Section Stacked below Horizontal Scroll -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/channels_constraint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/channels_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:fontFamily="sans-serif-light"
                    android:text="@string/channels_scroller"
                    android:textSize="21sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- explore button -->
                <Button
                    android:id="@+id/btn_explore"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/explore"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/explore_btn_bg"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="TouchTargetSizeCheck" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <include layout="@layout/layout_channels_list" />

<!--            TESTING STUFF MIGHT UNCOMMENT -->
<!--            padding start align everything to left-->
<!--            <androidx.recyclerview.widget.RecyclerView-->
<!--                android:id="@+id/recycler_view_channels"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:nestedScrollingEnabled="false"-->
<!--                android:paddingStart="16dp"-->
<!--                android:paddingEnd="16dp"-->
<!--                android:paddingBottom="20dp"-->
<!--                android:clipToPadding="false"/>-->

            <!-- Real RecyclerView (if you use one) should go here with:
                 android:layout_height="wrap_content"
                 android:nestedScrollingEnabled="false" -->
            <!-- This section contains the 'Find Channels' text and the two main buttons -->
            <LinearLayout
                android:id="@+id/find_channels_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/find_channels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="19dp"
                    android:layout_marginTop="10dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:fontFamily="sans-serif-light"
                    android:paddingBottom="10dp"
                    android:text="@string/findChannels"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_explore_more"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/explore_more"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorPrimary"
                    app:cornerRadius="25dp"
                    app:icon="@drawable/grid"
                    app:iconGravity="textStart"
                    app:strokeColor="@color/explore_btn_bg" />

                <Button
                    android:id="@+id/create_channel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/create_channel"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorPrimary"
                    app:cornerRadius="25dp"
                    app:icon="@drawable/add"
                    app:iconGravity="textStart"
                    app:strokeColor="@color/explore_btn_bg" />
            </LinearLayout>

            <!--            <androidx.recyclerview.widget.RecyclerView-->
<!--                android:id="@+id/recycler_view_find_channel"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:clipToPadding="false"-->
<!--                android:nestedScrollingEnabled="false"-->
<!--                android:paddingStart="20dp"-->
<!--                android:paddingEnd="16dp"-->
<!--                android:paddingBottom="20dp" />-->


<!--            for the explore and create channel buttons-->

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- floating action button pinned outside the scroller -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_edit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="15dp"
        android:backgroundTint="?android:attr/colorBackground"
        android:contentDescription="@string/edit_button"
        android:elevation="4dp"
        android:focusable="true"
        app:cornerRadius="4dp"
        app:fabCustomSize="40dp"
        app:fabSize="mini"
        app:layout_constraintBottom_toTopOf="@+id/btn_add_photo"
        app:layout_constraintEnd_toEndOf="parent"
        app:maxImageSize="20dp"
        android:clickable="true"
        app:srcCompat="@drawable/edit"
        app:tint="?android:attr/textColorPrimary" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_add_photo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="?attr/colorOnPrimaryContainer"
        android:contentDescription="@string/upload_stat_btn"
        android:elevation="6dp"
        android:focusable="true"
        android:scaleX="-1"
        android:clickable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/baseline_add_a_photo_24"
        app:tint="?attr/colorSurfaceVariant" />

</androidx.constraintlayout.widget.ConstraintLayout>